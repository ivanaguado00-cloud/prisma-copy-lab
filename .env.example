# PRISMA Copy Lab - variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Base de datos (SQLite local)
DATABASE_URL="file:./prisma/dev.db"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Activar cliente LLM mock (devuelve respuestas pregrabadas, útil para demo o tests)
# Valores aceptados: true | false
LLM_MOCK="false"

# NextAuth — generar con: openssl rand -base64 32
AUTH_SECRET=""
