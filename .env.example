# PRISMA Copy Lab - variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Base de datos
# Local (SQLite):       DATABASE_URL="file:./prisma/dev.db"
# Producción (Neon/PG): DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DATABASE_URL=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Activar cliente LLM mock (devuelve respuestas pregrabadas, útil para demo o tests)
# Valores aceptados: true | false
LLM_MOCK="false"

# NextAuth — generar con: openssl rand -base64 32
AUTH_SECRET=""

# ── CRM ───────────────────────────────────────────────────────────────────────
# Correo al que se envían las propuestas maquetadas para revisión interna de CRM.
# En entorno de prueba apunta al correo de verificación del proyecto.
CRM_RECIPIENT_EMAIL="ivan.aguado00@gmail.com"

# Modo de envío de email CRM.
#   mock  → registra el envío en consola, no envía nada real (por defecto en desarrollo).
#   smtp  → envía correo real usando las variables SMTP de abajo.
CRM_EMAIL_MODE="mock"

# SMTP para envío real de emails (solo necesario si CRM_EMAIL_MODE=smtp).
# Gmail: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
# SMTP_PASS es opcional si existe el archivo scripts/.gmailpass cifrado con DPAPI.
# Ver docs/email-security.md para instrucciones de generación.
SMTP_PASS=""
SMTP_FROM=""
