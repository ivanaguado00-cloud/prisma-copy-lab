# ============================================================
# PRISMA Copy Lab — .gitignore
# Stack: Next.js (App Router) + TypeScript + Prisma + SQLite
# ============================================================

# ----- Dependencias -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----- Build de Next.js -----
.next/
out/
build/
dist/

# ----- Variables de entorno (NUNCA subir claves reales) -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Conservamos .env.example como plantilla pública del proyecto
!.env.example

# ----- Credenciales cifradas locales (DPAPI) -----
# .gmailpass contiene una App Password de Gmail cifrada con DPAPI de Windows.
# Solo puede descifrarlo el mismo usuario en el mismo PC. Nunca subir al repo.
scripts/.gmailpass
.gmailpass

# ----- Base de datos local SQLite -----
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal
# Conservamos schema y migraciones (sí van al repo)
!prisma/schema.prisma
!prisma/migrations/

# ----- Logs y reportes -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# ----- Cobertura de tests -----
coverage/
*.lcov
.nyc_output/

# ----- Caches de herramientas -----
.cache/
.eslintcache
.stylelintcache
.turbo/
.swc/
next-env.d.ts

# ----- Certificados -----
*.pem

# ----- Sistema operativo -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- IDEs y editores -----
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ----- Archivos temporales del agente -----
.antigravity/
.claude/cache/
.claude/tmp/
.claude/settings.local.json
# Conservamos las skills (sí van al repo)
!.claude/skills/

# ----- Vercel (por si en el futuro se despliega) -----
.vercel

# ----- TypeScript -----
*.tsbuildinfo

# ----- Misc -----
*.local
.history/
tmp/

/src/generated/prisma
